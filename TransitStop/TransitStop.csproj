<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TransitStop</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TransitStop</PackageId>
    <Version>0.1.0</Version>
    <Authors>Baltermia Clopath</Authors>
    <Copyright>Copyright (c) 2026 Baltermia Clopath</Copyright>
    <Description>A development-time web UI for MassTransit: lists every message type your app knows about, lets you search them and publish or send them with an editable JSON payload. Works with any transport (RabbitMQ, in-memory, ...).</Description>
    <PackageTags>masstransit;rabbitmq;messaging;developer-tools;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/baltermia/transit-stop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/baltermia/transit-stop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Source Link (included in the .NET SDK) and a symbol package for debugging into the library -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- lowest supported version; the host app's (newer) MassTransit wins -->
    <PackageReference Include="MassTransit" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\index.html" LogicalName="TransitStop.ui.index.html" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
